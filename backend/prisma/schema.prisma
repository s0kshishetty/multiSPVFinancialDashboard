generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int                @id @default(autoincrement())
  email          String             @unique
  passwordHash   String
  role           String             @default("INVESTOR") // ADMIN, INVESTOR
  riskThreshold  String             @default("MEDIUM")   // LOW, MEDIUM, HIGH
  cashBalance    Float              @default(10000000.0) // $10M starting balance
  createdAt      DateTime           @default(now())
  transactions   Transaction[]
  holdings       PortfolioHolding[]
  watchlist      Watchlist[]
  reports        Report[]
  auditLogs      AuditLog[]
  alerts         Alert[]
}

model SPV {
  id             Int                @id @default(autoincrement())
  name           String
  type           String
  sector         String
  description    String
  riskLevel      String             @default("MEDIUM")
  esgScore       Float              @default(75.0)
  status         String             @default("Healthy")
  recommendation String             @default("Hold")
  createdAt      DateTime           @default(now())
  financialData  FinancialData[]
  alerts         Alert[]
  transactions   Transaction[]
  holdings       PortfolioHolding[]
  watchlist      Watchlist[]
  parentGroupId  Int?
  parentGroup    ParentGroup?       @relation(fields: [parentGroupId], references: [id])
}

model FinancialData {
  id         Int      @id @default(autoincrement())
  spvId      Int
  date       DateTime
  revenue    Float
  expenses   Float
  profit     Float
  assetValue Float
  debt       Float    @default(0)
  cashFlow   Float    @default(0)
  irr        Float    @default(0)
  spv        SPV      @relation(fields: [spvId], references: [id])
}

model Transaction {
  id        Int      @id @default(autoincrement())
  spvId     Int
  userId    Int
  type      String   // Buy, Sell, Hold
  shares    Float
  price     Float
  total     Float
  status    String   @default("COMPLETED") // PENDING, COMPLETED, FAILED
  createdAt DateTime @default(now())
  spv       SPV      @relation(fields: [spvId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model PortfolioHolding {
  id        Int      @id @default(autoincrement())
  userId    Int
  spvId     Int
  shares    Float
  avgPrice  Float
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  spv       SPV      @relation(fields: [spvId], references: [id])

  @@unique([userId, spvId])
}

model Alert {
  id        Int      @id @default(autoincrement())
  spvId     Int
  userId    Int?
  condition String
  message   String
  severity  String   @default("MEDIUM") // LOW, MEDIUM, CRITICAL
  isActive  Boolean  @default(true)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  spv       SPV      @relation(fields: [spvId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
}

model Report {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  type      String   // PDF, EXCEL
  fileUrl   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  details   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Watchlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  spvId     Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  spv       SPV      @relation(fields: [spvId], references: [id])

  @@unique([userId, spvId])
}

model ParentGroup {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  sector      String
  description String
  createdAt   DateTime @default(now())
  spvs        SPV[]
}
